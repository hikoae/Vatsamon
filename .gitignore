# dipendenze e build
node_modules/
app/node_modules/
app/dist/
app/dev-dist/
app/.vite/

# artefatti tsc -b (composite)
*.tsbuildinfo
app/vite.config.js
app/vite.config.d.ts

# env / configurazioni locali
.env
.env.local
app/.env
app/.env.local
.claude/

# os / editor
.DS_Store
*.log
/tmp/

# archivi (i contenuti sono già estratti in vatsamon/ e foto/)
*.zip
app/dist-netlify/

# backup/temp locali
*.bak
app/.env.local.bak

# env locali — copertura totale, presente e futura (il repo e' PUBBLICO)
# NB: l'eccezione va SEMPRE dopo la regola che cattura, e deve restare
# l'ultima riga che tocca .env.example, altrimenti torna ignorato.
.env*
!.env.example

# output di build alternativi (dist-fbtest/, dist-fbfinale/, ...)
# solo directory: il dist/ canonico resta gestito da app/dist/ sopra
dist-*/

# cache CLI/emulatori Firebase (i *-debug.log sono gia' coperti da *.log)
.firebase/
